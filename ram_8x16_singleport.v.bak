module ram_8x16_singleport(
         input we_in,re_in,rst,clk,
         input [2:0]addr_in,
         inout [15:0]data);

reg [15:0]mem[7:0];
reg [15:0] temp_data;
integer i;

always@(posedge clk)
if(rst)
   temp_data<=16'b0;
   for(i=0;i<8;i=i+1)
          begin
              mem[i]=16'b0;
          end
else if(we_in && !re_in)
   mem[addr_in]<=data;
else if (re_in && !we_in)
   temp_data<=mem[addr_in];
assign data = (re_in && !we_in) ? temp_data : 16'hz;

endmodule


